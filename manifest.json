  "share_target": {
    "action": "/?action=share-target&utm_source=pwa_share",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/?action=file-handler&utm_source=pwa_file",
      "accept": {
        "text/plain": [".txt", ".md"],
        "application/json": [".json", ".sneh"]
      }
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "protocol_handlers": [
    {
      "protocol": "web+snehaidbc",
      "url": "/?action=protocol&uri=%s"
    }
  ],
  "scope_extensions": [
    {
      "origin": "https://snehaidbc.netlify.app"
    }
  ],
  "screenshots": [
